{
  "name": "fiscal-lens-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "data:update": "node scripts/update-official-data.mjs",
    "data:update:prefectures": "node scripts/update-prefectural-data.mjs",
    "data:update:annual": "node scripts/prepare-annual-update.mjs",
    "data:check": "node scripts/validate-official-data.mjs public/official-data.json",
    "data:check:prefectures": "node scripts/validate-prefectural-data.mjs public/prefectural-data.json",
    "test:data": "node --test tests/official-data.test.mjs tests/prefectural-data.test.mjs tests/annual-update-workflow.test.mjs",
    "test": "npm run data:check && npm run data:check:prefectures && npm run test:data && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "exceljs": "4.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
